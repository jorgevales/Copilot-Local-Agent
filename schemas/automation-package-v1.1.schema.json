{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/automation-package-v1.1.schema.json",
  "title": "Copilot Local Agent automation package manifest v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "package_version",
    "task_id",
    "correlation_id",
    "description",
    "entrypoint",
    "files",
    "dependencies",
    "tools",
    "capabilities",
    "stages",
    "validation",
    "expected_outputs",
    "result_contract"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "package_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "package_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "entrypoint": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "files": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1000,
      "propertyNames": {
        "maxLength": 240
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "python_min",
        "modules"
      ],
      "properties": {
        "python_min": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+$",
          "maxLength": 32
        },
        "modules": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
            "maxLength": 100
          }
        }
      }
    },
    "tools": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "read_paths",
        "create_paths",
        "modify_paths",
        "network_destinations",
        "imports",
        "permissions",
        "max_runtime_seconds",
        "max_output_chars",
        "max_concurrency"
      ],
      "properties": {
        "read_paths": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "maxLength": 240
          }
        },
        "create_paths": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "maxLength": 240
          }
        },
        "modify_paths": {
          "type": "array",
          "maxItems": 0,
          "items": {
            "type": "string",
            "maxLength": 240
          }
        },
        "network_destinations": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 300
          }
        },
        "imports": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 100
          }
        },
        "permissions": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "enum": [
              "read_files",
              "create_files",
              "network"
            ]
          }
        },
        "max_runtime_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1800
        },
        "max_output_chars": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "max_concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "depends_on",
          "inputs",
          "outputs",
          "timeout_seconds",
          "retries",
          "idempotent",
          "checkpoint"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "kind": {
            "enum": [
              "python",
              "tool"
            ]
          },
          "script": {
            "type": "string",
            "maxLength": 240
          },
          "tool_id": {
            "type": "string",
            "maxLength": 120
          },
          "arguments": {
            "type": "object"
          },
          "depends_on": {
            "type": "array",
            "maxItems": 100,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "maxLength": 120
            }
          },
          "inputs": {
            "type": "array",
            "maxItems": 100,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "maxLength": 240
            }
          },
          "outputs": {
            "type": "array",
            "maxItems": 100,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "maxLength": 240
            }
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1800
          },
          "retries": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "idempotent": {
            "type": "boolean"
          },
          "checkpoint": {
            "type": "boolean"
          },
          "imports": {
            "type": "array",
            "maxItems": 100,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "maxLength": 100
            }
          },
          "network_destinations": {
            "type": "array",
            "maxItems": 100,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "maxLength": 300
            }
          },
          "permissions": {
            "type": "array",
            "maxItems": 20,
            "uniqueItems": true,
            "items": {
              "enum": [
                "read_files",
                "create_files",
                "network"
              ]
            }
          },
          "arguments_list": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "string",
              "maxLength": 4000
            }
          },
          "failure_policy": {
            "enum": [
              "stop",
              "continue"
            ]
          },
          "result_bindings": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "json_pointer",
                "type",
                "max_bytes"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
                  "maxLength": 64
                },
                "json_pointer": {
                  "type": "string",
                  "pattern": "^/result/",
                  "maxLength": 500
                },
                "type": {
                  "enum": [
                    "string",
                    "integer",
                    "number",
                    "boolean",
                    "object",
                    "array"
                  ]
                },
                "max_bytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 12000
                }
              }
            }
          }
        }
      }
    },
    "validation": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "path"
        ],
        "properties": {
          "kind": {
            "enum": [
              "exists",
              "sha256",
              "python_syntax"
            ]
          },
          "path": {
            "type": "string",
            "maxLength": 240
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "expected_outputs": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 240
      }
    },
    "result_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "summary"
      ],
      "properties": {
        "status": {
          "enum": [
            "complete",
            "partial",
            "blocked",
            "failed"
          ]
        },
        "summary": {
          "type": "string",
          "maxLength": 2000
        }
      }
    },
    "rollback": {
      "type": "string",
      "maxLength": 2000
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agent_min": {
          "type": "string",
          "maxLength": 32
        },
        "agent_max": {
          "type": "string",
          "maxLength": 32
        }
      }
    }
  }
}

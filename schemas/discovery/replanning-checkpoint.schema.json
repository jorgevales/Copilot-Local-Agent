{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/replanning-checkpoint.schema.json",
  "title": "PROPOSED replanning-checkpoint v1",
  "type": "object",
  "properties": {
    "version": {
      "const": "1.0"
    },
    "kind": {
      "const": "replanning_checkpoint"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
    },
    "graph_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "reason": {
      "type": "string",
      "enum": [
        "new_application_topology",
        "incompatible_capability",
        "unresolved_material_contradiction"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "scope": {
      "type": "object",
      "properties": {
        "origins": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048
          },
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true
        },
        "allow_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true
        },
        "exclude_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "minItems": 0,
          "maxItems": 50,
          "uniqueItems": true
        },
        "query_keys": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "minItems": 0,
          "maxItems": 30,
          "uniqueItems": true
        },
        "max_query_variants": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "allow_private_network": {
          "const": false
        },
        "redirect_limit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        }
      },
      "required": [
        "origins",
        "allow_paths",
        "exclude_paths",
        "query_keys",
        "max_query_variants",
        "allow_private_network",
        "redirect_limit"
      ],
      "additionalProperties": false
    },
    "affected_tasks": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
      },
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true
    },
    "completed_tasks": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
      },
      "minItems": 0,
      "maxItems": 1000,
      "uniqueItems": true
    },
    "retained_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "type": {
            "type": "string",
            "enum": [
              "scope",
              "page",
              "network",
              "structure",
              "boundary",
              "diagnostic"
            ]
          },
          "task_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "source_url": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "content_hash": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "structural_fingerprint": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "artifact_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "redaction": {
            "const": "passed"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "required": [
          "id",
          "type",
          "task_id",
          "source_url",
          "observed_at",
          "content_hash",
          "structural_fingerprint",
          "artifact_ref",
          "redaction",
          "confidence",
          "summary"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 100
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      },
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true
    },
    "attempted_recovery": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      },
      "minItems": 0,
      "maxItems": 20,
      "uniqueItems": true
    },
    "remaining_budgets": {
      "type": "object",
      "properties": {
        "run_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "task_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "branch_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1800
        },
        "pages": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "tasks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5000
        },
        "requests": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5000
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "per_origin_concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "browser_contexts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "per_origin_rps": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 5
        },
        "backoff_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300
        },
        "browser_restarts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "replans": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "output_repairs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "run_seconds",
        "task_seconds",
        "branch_seconds",
        "pages",
        "tasks",
        "requests",
        "bytes",
        "concurrency",
        "per_origin_concurrency",
        "attempts",
        "depth",
        "browser_contexts",
        "per_origin_rps",
        "backoff_seconds",
        "browser_restarts",
        "replans",
        "output_repairs"
      ],
      "additionalProperties": false
    },
    "permitted_workers": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "bootstrap",
          "http",
          "browser",
          "network",
          "structure",
          "validate",
          "aggregate"
        ]
      },
      "minItems": 1,
      "maxItems": 7,
      "uniqueItems": true
    },
    "allowed_changes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "replace_pending_task",
          "add_scoped_task",
          "skip_pending_task"
        ]
      },
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true
    },
    "deadline": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "version",
    "kind",
    "request_id",
    "run_id",
    "graph_revision",
    "reason",
    "objective",
    "scope",
    "affected_tasks",
    "completed_tasks",
    "retained_evidence",
    "observations",
    "attempted_recovery",
    "remaining_budgets",
    "permitted_workers",
    "allowed_changes",
    "deadline"
  ],
  "additionalProperties": false
}
